.cache/

_build/

# Ship the verified CPFT preprocessing bundle and its prebuilt scenario
# library; keep other input data ignored.
!backend/data/
backend/data/*
!backend/data/cpft_preprocessing.json
!backend/data/cpft_library.npz
!backend/data/calendar_effects.json
!backend/data/charger_position_overrides.json
