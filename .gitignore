# Folders
data/
.vscode/
occupancy_data/data

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data
*.gpkg
!seed_data/*.gpkg
*.data

# Individual
run.py
instance/
logs/

# mod_spatialite bundle installed by scripts/install_spatialite.py
.spatialite/

