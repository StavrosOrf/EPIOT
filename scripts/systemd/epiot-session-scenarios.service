[Unit]
Description=Prepare EPIOT daily session scenarios
After=network.target

[Service]
Type=oneshot
User=epiot
WorkingDirectory=/opt/epiot
Environment=TF_CPP_MIN_LOG_LEVEL=2
Environment=TF_ENABLE_ONEDNN_OPTS=0
ExecStart=/opt/epiot/.venv/bin/python /opt/epiot/scripts/prepare_session_scenarios.py
TimeoutStartSec=30min
Nice=10
CPUQuota=100%
